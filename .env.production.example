# pato岡山（仮） 本番環境の雛形
# 値を埋めたら `php artisan pato:release-check` が緑になることを確認する。

APP_NAME="pato岡山"
APP_ENV=production
# php -r 'echo "base64:".base64_encode(random_bytes(32)),PHP_EOL;' で生成。
# セッションと暗号化カラム（生年月日など）の鍵。後から変えると既存データが読めなくなる
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

# --- Docker（compose.prod.yaml が参照する） ---
# TLS 証明書を自動取得するドメイン。DNS の A レコードをこのサーバへ向けておくこと
DOMAIN=example.com
# Let's Encrypt からの失効通知の宛先
LETSENCRYPT_EMAIL=
# デプロイするイメージのタグ。git のコミットハッシュを入れると切り戻しやすい
APP_VERSION=latest

# --- DB / キャッシュ / キュー ---
DB_CONNECTION=mysql
# compose.prod.yaml を使う場合はサービス名（mysql / redis）を指定する
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pato
DB_USERNAME=
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# compose.prod.yaml では Redis に必須。空だと起動しない（セッションとキューが載るため）
REDIS_PASSWORD=

# 本番は Redis を使う（キュー・セッション・キャッシュ）
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- ログ（PIIマスク付きチャンネル） ---
LOG_CHANNEL=daily
LOG_LEVEL=warning

# --- 事業者情報（特商法表記） ---
PATO_OPERATOR_NAME=
PATO_OPERATOR_REP=
PATO_OPERATOR_ADDRESS=
PATO_CONTACT_EMAIL=
PATO_CONTACT_PHONE=

# --- インターネット異性紹介事業の届出番号 ---
# 岡山県公安委員会へ自社名義で届け出て取得した番号のみ設定する。
# 他社（pato等）の番号は使用不可。未取得のうちは空のまま（公開はできない）。
PATO_IDS_REGISTRATION=

# --- 決済（Stripe） ---
# pk_...  ブラウザに出る公開可能キー。未設定だとカード入力欄が出ない（デモ画面のまま）
STRIPE_PUBLISHABLE_KEY=
# sk_...  秘密鍵。漏れると任意の課金・返金ができる。ビューに渡さない・ログに出さない
STRIPE_SECRET=
# whsec_... Webhook 署名シークレット。未設定だと返金通知を全拒否＝ポイントを回収できない。
#           ダッシュボードで https://<ドメイン>/webhooks/stripe を登録すると発行される
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=jpy

# --- 本人確認（eKYC ベンダ） ---
EKYC_BASE_URL=
EKYC_API_KEY=

# --- Web Push（VAPID） ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
